# **Время выполнения:** ~6 часов
# 
# ### Особенности решения:
# - Генерация 1.1 млн строк (масштабируемо до 100M).
# - Параллельная обработка данных (Multiprocessing).
# - Векторизованные операции (вместо циклов) для работы с Big Data.
# - Статистический анализ (ANOVA, Z-тест, Байесовский фактор).

# %% [markdown]
# ## 1. Генерация датасета
import numpy as np
import pandas as pd
from datetime import datetime, timedelta
import random
import os

N_ROWS = 1_000_000 
DUPLICATE_FRACTION = 0.1
START_DATE = datetime(2020, 1, 1)

np.random.seed(42)
random.seed(42)

# Генерация данных
timestamps = [START_DATE + timedelta(seconds=np.random.randint(0, 3*365*86400)) for _ in range(N_ROWS)]
numeric_values = np.random.uniform(0, 100, N_ROWS)
string_values = [''.join(random.choices('abcdefghijklmnopqrstuvwxyz0123456789', k=7)) for _ in range(N_ROWS)]

df = pd.DataFrame({
    'timestamp': timestamps,
    'numeric_value': numeric_values,
    'string_value': string_values
})

# Добавление дубликатов и сохранение
df = pd.concat([df, df.sample(frac=DUPLICATE_FRACTION)], ignore_index=True)
df.to_csv('large_dataset.csv', index=False)
print(f"Датасет готов: {len(df):,} строк")

# %% [markdown]
# ## 2. Считывание и процессинг (Параллельно)
import concurrent.futures
import multiprocessing

def process_chunk(chunk):
    chunk = chunk.dropna()
    # Векторизованная замена: если нет цифр -> пустая строка
    chunk.loc[~chunk['string_value'].str.contains(r'\d', na=False), 'string_value'] = ''
    # Фильтр времени (исключаем 1:00 - 3:00 ночи)
    chunk = chunk[~chunk['timestamp'].dt.hour.isin([1, 2])]
    return chunk

def parallel_processing(file_path):
    n_workers = multiprocessing.cpu_count()
    chunks = pd.read_csv(file_path, chunksize=200_000, parse_dates=['timestamp'])
    
    with concurrent.futures.ProcessPoolExecutor(max_workers=n_workers) as executor:
        futures = [executor.submit(process_chunk, chunk) for chunk in chunks]
        results = [f.result() for f in concurrent.futures.as_completed(futures)]
    
    full_df = pd.concat(results, ignore_index=True)
    # Удаление дублей, которые оказались в разных чанках
    full_df = full_df.drop_duplicates().reset_index(drop=True)
    return full_df

df_processed = parallel_processing('large_dataset.csv')
print(f"После очистки: {len(df_processed):,} строк")

# %% [markdown]
# ## 3. Расчет метрик и SQL
df_processed['hour_ts'] = df_processed['timestamp'].dt.floor('H')

hourly_metrics = df_processed.groupby('hour_ts').agg(
    unique_strings=('string_value', 'nunique'),
    mean_numeric=('numeric_value', 'mean'),
    median_numeric=('numeric_value', 'median')
).reset_index()

# SQL-запрос (для комментария в коде)
# """
# SELECT DATE_TRUNC('hour', timestamp) AS hour_ts,
#        COUNT(DISTINCT string_value) AS unique_strings,
#        AVG(numeric_value) AS mean_numeric,
#        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY numeric_value) AS median_numeric
# FROM table WHERE EXTRACT(HOUR FROM timestamp) NOT IN (1, 2)
# GROUP BY 1 ORDER BY 1;
# """

# Мерж метрик с основным датасетом
df_final = df_processed.merge(hourly_metrics, on='hour_ts', how='left')

# %% [markdown]
# ## 4. Аналитика и Визуализация
import matplotlib.pyplot as plt
import seaborn as sns

# 4.1 Доверительный интервал (95%)
mean, std, n = df_final['numeric_value'].mean(), df_final['numeric_value'].std(), len(df_final)
ci_low = mean - 1.96 * (std / np.sqrt(n))
ci_high = mean + 1.96 * (std / np.sqrt(n))
print(f"95% Доверительный интервал для среднего: [{ci_low:.4f}, {ci_high:.4f}]")

# 4.2 Heatmap (Оптимизированный расчет через векторизацию)
def get_heatmap_data(series, max_pos=10):
    # Разрезаем строки на символы и считаем частоты по позициям
    chars = series.str.slice(0, max_pos).apply(list).apply(pd.Series)
    matrix = chars.apply(lambda x: x.value_counts(normalize=True))
    return matrix.reindex(list('abcdefghijklmnopqrstuvwxyz0123456789')).fillna(0) * 100

plt.figure(figsize=(12, 6))
sns.heatmap(get_heatmap_data(df_final['string_value'].sample(100_000)), cmap='YlOrRd')
plt.title("Heatmap частотности символов")
plt.show()

# %% [markdown]
# ## 5. Доп. задание 1 (Статистика)
from scipy import stats
import pingouin as pg

# Разделение 25/25/50
df_A = df_final.sample(frac=0.5, random_state=42)
df_remain = df_final.drop(df_A.index)
df_B = df_remain.sample(frac=0.5, random_state=42)
df_C = df_remain.drop(df_B.index)

# ANOVA тест
f_stat, p_pval = stats.f_oneway(df_A['numeric_value'], df_B['numeric_value'], df_C['numeric_value'])
print(f"ANOVA p-value: {p_pval:.4f}")

# Байесовский t-тест (A vs B)
bf = pg.bayesfactor_ttest(df_A['numeric_value'].sample(10000), df_B['numeric_value'].sample(10000))
print(f"Bayes Factor: {bf:.4f}")

